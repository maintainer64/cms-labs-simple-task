{
  "apiVersion": "cms.labs/v1",
  "kind": "Lab",
  "metadata": {
    "name": "sdn-lab-5",
    "moduleId": "SDN_Lab_5"
  },
  "spec": {
    "title": "Лабораторная работа 5: автоматизация SSH и мониторинг SNMP",
    "description": "Настройка Linux-based сетевых узлов из Jupyter Notebook и автоматическая проверка результата.",
    "types": {
      "subject": "network-lab",
      "interface": "jupyter-notebook",
      "topology": [
        "containerlab",
        "clabernetes"
      ],
      "assessment": "automatic-checker"
    },
    "execution": [
      "github-codespaces",
      "local-devcontainer",
      "clabgate-kubernetes"
    ],
    "labPath": "modules/SDN_Lab_5/Lab5.ipynb",
    "testPath": "sdn_lab_5",
    "topologyPath": "modules/SDN_Lab_5/topology.template.yaml",
    "runtime": {
      "jupyterImage": "ghcr.io/maintainer64/cms-labs-jupyter:latest",
      "checkerImage": "ghcr.io/maintainer64/cms-labs-checker:latest",
      "nodeImage": "ghcr.io/maintainer64/cms-labs-tasks-sdn-lab-5-node:latest"
    }
  }
}
